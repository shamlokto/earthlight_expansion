 (the loaded Crabs) before any reaches the east edge.","routes":[{"prio":1,"x":2,"y":7},{"prio":2,"x":5,"y":7},{"prio":3,"x":8,"y":7},{"prio":4,"x":11,"y":7},{"prio":5,"x":14,"y":7},{"prio":6,"x":17,"y":7},{"prio":7,"x":20,"y":7},{"prio":8,"x":23,"y":7},{"prio":9,"x":26,"y":7},{"prio":10,"x":29,"y":7},{"prio":11,"x":32,"y":7},{"prio":12,"x":35,"y":7},{"prio":13,"x":38,"y":7},{"prio":14,"x":41,"y":6},{"prio":15,"x":44,"y":6},{"prio":1,"x":2,"y":15},{"prio":2,"x":5,"y":15},{"prio":3,"x":8,"y":15},{"prio":4,"x":11,"y":15},{"prio":5,"x":14,"y":15},{"prio":6,"x":17,"y":15},{"prio":7,"x":20,"y":15},{"prio":8,"x":23,"y":15},{"prio":9,"x":26,"y":15},{"prio":10,"x":29,"y":15},{"prio":11,"x":32,"y":15},{"prio":12,"x":35,"y":15},{"prio":13,"x":38,"y":15},{"prio":14,"x":41,"y":15},{"prio":15,"x":44,"y":15}]}