y":1,"x":30,"y":10},{"type":52,"army":0,"x":38,"y":10,"neutral":true,"cargo":[0,3,1]},{"type":40,"army":0,"x":6,"y":11},{"type":19,"army":1,"x":45,"y":11},{"type":38,"army":1,"x":48,"y":11,"cargo":[9]},{"type":3,"army":0,"x":2,"y":12},{"type":0,"army":0,"x":4,"y":12},{"type":17,"army":1,"x":20,"y":12},{"type":51,"army":1,"x":35,"y":12},{"type":36,"army":1,"x":35,"y":13,"cargo":[9]},{"type":51,"army":1,"x":53,"y":13},{"type":1,"army":0,"x":3,"y":14},{"type":8,"army":0,"x":5,"y":14},{"type":28,"army":1,"x":24,"y":14},{"type":8,"army":1,"x":30,"y":14},{"type":8,"army":1,"x":41,"y":14},{"type":22,"army":1,"x":40,"y":15},{"type":36,"army":1,"x":56,"y":15},{"type":42,"army":0,"x":4,"y":16},{"type":28,"army":1,"x":46,"y":17}],"arrivals":[{"turn":4,"army":1,"units":[{"type":51,"x":58,"y":3},{"type":51,"x":58,"y":17},{"type":50,"x":59,"y":5},{"type":8,"x":59,"y":15},{"type":9,"x":59,"y":2}]}],"objective":{"kind":"carriers"},"general":{"x":3,"y":10},"turnLimit":22,"cap":15,"music":25,"briefing":"We said no. Moraine's price was a dock at Olympos when this is over, and the right to sell anything that flies out of it. The General would not buy a war from one tyrant to sell it to another.\n\nShe will not forgive that, and she will not wait. So we hit her first. The cartel fleet rides at anchor in the Ashfall scrapyard, a field of dead hulls and broken rock. Her carriers are the cartel's teeth: sink every one and Moraine is just a woman with a scrapyard.\n\nTwo grey docks sit on the moorings, half-stripped and unmanned. Take them and their cargo is ours. Her raiders are out on a run and will come home from the east on the fifth turn.","goal":"Sink every cartel carrier in the Ashfall scrapyard within 22 turns.","ending":"Arkin went in after the last carrier alone. We found his Athena drifting in the yard after the fighting stopped, its canopy open to space. The cartel fleet is broken, and the remnant has one less ace. Sato logged the loss in three lines and did not speak for the rest of the watch.","chapter":"Act II · The Fork · Mission 6","strategy":["Remora drones are decoys: shoot through them, don't chase them. Pandora mines sit in the lanes; clear them with ranged fire.","Advance down the open lanes between the islands; carriers and ships can't enter the asteroids or meteoroids.","Capture the two grey docks on the moorings early: they hold reinforcements for you.","Moraine's raiders return from the east on turn 5. Sink the near carriers first, then turn to meet them.","The last carrier anchors by the gravity well in the far east. Keep enough fast units to finish it before turn 22."],"plan":[{"n":2,"path":[[6,10],[16,9],[28,7]]},{"n":3,"at":[22,10],"note":"Grey dock"},{"n":3,"at":[38,10],"note":"Grey dock"},{"n":4,"at":[58,4],"note":"Raiders T5"},{"n":5,"path":[[36,12],[46,13],[54,15]]}],"comms":[{"speaker":"moraine","text":"You could have had my fleet, General. Now you'll have to take it, one hull at a time."},{"speaker":"arkin","text":"Let me lead the strike on the far carriers. I've waited all war to fly through that yard."},{"speaker":"sato","text":"Arkin, stay on the formation. Those Remora drones are bait. Do not chase them."},{"speaker":"ruess","text":"The two moorings in the middle still have docks on them. Park a unit next to one and it is ours."},{"speaker":"kessrin","text":"Pirates killing traitors. Traitors killing pirates. I shall simply wait and count the survivors."}]}