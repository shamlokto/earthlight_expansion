4,"y":7},{"type":0,"army":1,"x":29,"y":8},{"type":0,"army":1,"x":34,"y":8},{"type":56,"army":1,"x":28,"y":9},{"type":23,"army":1,"x":34,"y":9},{"type":42,"army":1,"x":47,"y":10},{"type":40,"army":1,"x":56,"y":10},{"type":2,"army":1,"x":26,"y":11},{"type":2,"army":1,"x":31,"y":11},{"type":2,"army":1,"x":38,"y":12},{"type":39,"army":1,"x":50,"y":12},{"type":34,"army":0,"x":1,"y":13,"cargo":[8,9]},{"type":31,"army":1,"x":52,"y":13},{"type":39,"army":0,"x":2,"y":14},{"type":2,"army":1,"x":22,"y":14},{"type":23,"army":1,"x":29,"y":14},{"type":56,"army":1,"x":35,"y":14},{"type":40,"army":0,"x":1,"y":15},{"type":0,"army":0,"x":3,"y":15},{"type":40,"army":0,"x":2,"y":16},{"type":0,"army":1,"x":21,"y":16},{"type":0,"army":1,"x":28,"y":16},{"type":3,"army":1,"x":33,"y":16},{"type":42,"army":1,"x":50,"y":16},{"type":38,"army":0,"x":1,"y":17},{"type":56,"army":1,"x":20,"y":17},{"type":3,"army":1,"x":24,"y":19},{"type":40,"army":1,"x":52,"y":19},{"type":49,"army":1,"x":46,"y":20},{"type":39,"army":1,"x":42,"y":22},{"type":49,"army":1,"x":55,"y":23},{"type":34,"army":1,"x":8,"y":26,"cargo":[8]},{"type":38,"army":1,"x":26,"y":26,"cargo":[9]},{"type":36,"army":1,"x":44,"y":26,"cargo":[9]},{"type":36,"army":1,"x":17,"y":27,"cargo":[10]},{"type":34,"army":1,"x":35,"y":27,"cargo":[8]},{"type":38,"army":1,"x":53,"y":27,"cargo":[10]}],"arrivals":[{"turn":3,"army":1,"units":[{"type":8,"x":12,"y":24},{"type":8,"x":22,"y":24},{"type":9,"x":32,"y":23},{"type":8,"x":42,"y":24},{"type":9,"x":50,"y":24}]}],"objective":{"kind":"command"},"general":{"x":2,"y":2},"turnLimit":30,"cap":20,"music":29,"briefing":"Earth orbit. Babylon.\n\nIt never fired. The Union has told the Foundries that for a month, and it is true: the great cannon went into the sea with the ship that carried it. Now we know why they keep saying it. The wreck is not in the sea. Most of the hull broke away on the way down and hangs above the atmosphere, and the Union has crews inside cutting the cannon free.\n\nThree Cortex centres run the salvage from the hull's sealed chambers. Two Dragon beam batteries still work on its railways. Six carriers sit in the upper atmosphere and launch fighters at anything that comes near, and the home fleet waits behind the asteroids to the east.\n\nWe come down from high orbit on three fronts. In the northwest the magnetic belt runs almost to the hull: their beam weapons can't touch a ship inside it. Destroy the three command centres and the cannon stays where it is.","goal":"Destroy the three Cortex command centres inside Babylon's hull.","guards":2,"chapter":"Chapter 7 · Earth orbit, the wreck of Babylon","transmission":"Babylon never fired. That is the trouble with emperors, General: they hesitate. I won't.","strategy":["Your northwest group rides the magnetic belt down to the hull's west end: the Dragons' beams can't touch a ship inside it.","The north group drops straight onto the hull. Don't trade with the carriers: kill fighters only when they block your way.","The west group crosses the plasma lake and the meteoroids to the southern Cortex.","A wave of fighters launches from the atmosphere on turn 4. Be inside the hull by then.","Three Cortex centres: kill them all. The home fleet behind the eastern asteroids will come once you're committed."],"plan":[{"n":1,"path":[[3,5],[9,9],[16,12]]},{"n":2,"path":[[24,2],[26,5],[28,8]]},{"n":3,"path":[[3,15],[11,17],[19,17]]},{"n":4,"at":[30,23],"note":"Fighter wave T4"}]}